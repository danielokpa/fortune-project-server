enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  RECRUITER
  HIRING_MANAGER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENED
  ASSESSMENT_PENDING
  ASSESSMENT_COMPLETED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum CandidateClassification {
  STRONG_FIT
  CONDITIONAL_FIT
  WILD_CARD
  FIT_LATER
  WEAK_MATCH
}

enum DocumentType {
  PHOTO
  CV
  DRIVERS_LICENSE
  NYSC
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuestionCategory {
  PROFESSIONAL_ATTITUDE
  EMOTIONAL_INTELLIGENCE
  CUSTOMER_SERVICE
  SAFETY
  AVAILABILITY
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RolePlayCategory {
  CUSTOMER_SERVICE
  EMOTIONAL_INTELLIGENCE
  PROFESSIONALISM
  SAFETY
  INTEGRITY
  PROBLEM_SOLVING
  CONFLICT_RESOLUTION
}
model Organization {
  id String @id @default(uuid())

  name String

  users User[]
  jobs  Job[]

  createdAt DateTime @default(now())
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String

  firstName String
  lastName  String

  role Role

  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  createdJobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id String @id @default(uuid())

  subject TokenSubject
  token   String

  email   String?
  phoneNo String?

  tokenType TokenType

  expiry DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phoneNo])
  @@index([token])
  @@index([expiry])
  @@map("tokens")
}

model Candidate {
  id String @id @default(uuid())
  // candidateCode         String @unique

  fullName String
  email    String     @unique
  phone    String     @unique

  whatsapp String?

  residentialAddress String

  gender String

  dateOfBirth DateTime

  stateOfOrigin String

  currentLocation String

  highestQualification String

  yearsOfExperience Int?

  applications Application[]

  documents CandidateDocument[]

  createdAt DateTime @default(now())

  @@unique([email])
}

model CandidateDocument {
  id String @id @default(uuid())

  candidateId String

  type DocumentType

  fileUrl String

  candidate Candidate @relation(fields: [candidateId], references: [id])

  createdAt DateTime @default(now())

  @@unique([candidateId, type])
}

model Job {
  id String @id @default(uuid())

  organizationId String

  slug String @unique

  title       String
  description String

  status JobStatus @default(DRAFT)

  createdById String

  organization Organization @relation(fields: [organizationId], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  applications Application[]

  assessment Assessment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(uuid())

  jobId       String
  candidateId String

  source String?

  status ApplicationStatus @default(APPLIED)

  fitScore Float?

  classification CandidateClassification?

  job Job @relation(fields: [jobId], references: [id])

  candidate Candidate @relation(fields: [candidateId], references: [id])

  assessmentAttempt AssessmentAttempt?

  interviews Interview[]

  statusHistory ApplicationStatusHistory[]

  createdAt DateTime @default(now())

  @@unique([jobId, candidateId])
}

model ApplicationStatusHistory {
  id String @id @default(uuid())

  applicationId String

  status ApplicationStatus

  application Application @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
}

model Assessment {
  id String @id @default(uuid())

  jobId String @unique

  slug String @unique

  title String

  durationMinutes Int

  passingScore Int

  job Job @relation(fields: [jobId], references: [id])

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
}

model AssessmentAttempt {
  id String @id @default(uuid())

  assessmentId String

  applicationId String? @unique

  score Float?

  passed Boolean?

  status AssessmentStatus @default(NOT_STARTED)

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  application Application? @relation(fields: [applicationId], references: [id])

  generatedQuestions AssessmentAttemptQuestion[]

  generatedRolePlays AssessmentAttemptRolePlay[]

  answers AssessmentAnswer[]

  rolePlayAnswers RolePlayAnswer[]

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
}

model AssessmentAnswer {
  id String @id @default(uuid())

  attemptId        String
  questionId       String
  selectedOptionId String

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  question QuestionBank @relation(fields: [questionId], references: [id])

  selectedOption QuestionBankOption @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

model RolePlayAnswer {
  id String @id @default(uuid())

  attemptId String

  questionId String

  answer String

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  question RolePlayBank @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model QuestionBank {
  id String @id @default(uuid())

  category QuestionCategory

  difficulty QuestionDifficulty

  question String   @unique

  weight Int @default(5)

  options QuestionBankOption[]

  answers AssessmentAnswer[]

  createdAt                  DateTime                    @default(now())
  assessmentAttemptQuestions AssessmentAttemptQuestion[]
}

model QuestionBankOption {
  id String @id @default(uuid())

  questionId String

  optionText String

  isCorrect Boolean

  question QuestionBank @relation(fields: [questionId], references: [id])

  selectedAnswers AssessmentAnswer[]
}

model RolePlayBank {
  id String @id @default(uuid())

  category RolePlayCategory?

  prompt String

  answers RolePlayAnswer[]

  createdAt                  DateTime                    @default(now())
  assessmentAttemptRolePlays AssessmentAttemptRolePlay[]
}

model AssessmentAttemptQuestion {
  id String @id @default(uuid())

  attemptId String

  questionId String

  displayOrder Int

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  question QuestionBank @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])

  @@unique([attemptId, questionId])
}

model AssessmentAttemptRolePlay {
  id String @id @default(uuid())

  attemptId String

  questionId String

  displayOrder Int

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])

  question RolePlayBank @relation(fields: [questionId], references: [id])
  
  @@index([attemptId])
  @@index([questionId])

  @@unique([attemptId, questionId])
}

model Interview {
  id String @id @default(uuid())

  applicationId String

  scheduledAt DateTime

  meetingLink String?

  notes String?

  score Float?

  status InterviewStatus @default(SCHEDULED)

  application Application @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
}
