  NORMAL
  SOCIAL
}

enum TokenType {
  OTP
  JWT
  REFRESH
}

enum TokenSubject {
  FORGOT_PASSWORD
  SIGN_UP_PHONE
  SIGN_UP_EMAIL
  NEW_DEVICE_LOGIN_OTP
  RESET_PASSCODE
}

