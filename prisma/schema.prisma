generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum VerificationMethod {
  QR_FINGERPRINT
  QR_PIN
}

enum AttendanceStatus {
  PRESENT
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  student              Student?
  courses              Course[]            @relation("CourseLecturer")
  sessions             AttendanceSession[] @relation("SessionLecturer")
  auditLogs            AuditLog[]
  webauthnChallenges   WebAuthnChallenge[]

  @@map("users")
}

model Student {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  matricNumber String  @unique
  department   String
  pinHash      String?

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  records       AttendanceRecord[]
  credentials   WebAuthnCredential[]
  authAttempts  BiometricAttempt[]

  @@map("students")
}

model Course {
  id         Int    @id @default(autoincrement())
  courseCode String @unique
  title      String
  unitLoad   Int
  lecturerId Int

  lecturer    User                 @relation("CourseLecturer", fields: [lecturerId], references: [id])
  enrollments Enrollment[]
  sessions    AttendanceSession[]

  @@map("courses")
}

model Enrollment {
  id               Int    @id @default(autoincrement())
  studentId        Int
  courseId         Int
  academicSession  String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, academicSession])
  @@map("enrollments")
}

model AttendanceSession {
  id          Int           @id @default(autoincrement())
  courseId    Int
  lecturerId  Int
  qrToken     String        @unique
  tokenExpiry DateTime
  status      SessionStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer User                @relation("SessionLecturer", fields: [lecturerId], references: [id])
  records  AttendanceRecord[]
  attempts BiometricAttempt[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                 Int                 @id @default(autoincrement())
  sessionId          Int
  studentId          Int
  timestamp          DateTime            @default(now())
  verificationMethod VerificationMethod
  status             AttendanceStatus    @default(PRESENT)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

model WebAuthnCredential {
  credentialId String   @id
  studentId    Int
  publicKey    String
  signCount    Int      @default(0)
  deviceInfo   String?
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  challenge String
  sessionId Int?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("webauthn_challenges")
}

model BiometricAttempt {
  id        Int @id @default(autoincrement())
  sessionId Int
  studentId Int
  failCount Int @default(0)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("biometric_attempts")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  metadata  String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
